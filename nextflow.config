docker.enabled = false
conda.enabled = true
/*
* Pipeline parameters
*/
params {
    input = "${projectDir}/raw_data"
    outdir = "${projectDir}/output/merged_data"
    nanoq_outdir = "${projectDir}/output/nanoq"
    nanoq_output_format = 'fastq.gz'
    nanoq_min_q = 10
    nanoq_min_len = 1000
    nanoq_max_len = 50000
}

process {
    withLabel:process_single {
        cpus   = 1
        memory = 1.GB
        time   = 1.h
    }
    withName: NANOQ {
        ext.args = "-q ${params.nanoq_min_q} -l ${params.nanoq_min_len} -m ${params.nanoq_max_len}"
    }
}
