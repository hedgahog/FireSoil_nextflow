docker.enabled = false
conda.enabled = true
/*
* Pipeline parameters
*/

manifest {
    name            = 'hedgahog/FireSoil_nextflow'
    description     = 'Nanopore 16S classification of fire-affected soil'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
}

params {
    input = "${projectDir}/raw_data"
    outdir = "${projectDir}/results"
    nanoq_output_format = 'fastq.gz'
    nanoq_min_q = 10
    nanoq_min_len = 1000
    nanoq_max_len = 50000
    emu_db = "${projectDir}/databases/emu"
}

process {
    withLabel:process_single {
        cpus   = 1
        memory = 1.GB
        time   = 1.h
    }
    withName: CAT_FASTQ {
        publishDir = [ path: "${params.outdir}/merged", mode: 'copy' ]
    }
    withName: NANOQ {
        ext.args   = "-q ${params.nanoq_min_q} -l ${params.nanoq_min_len} -m ${params.nanoq_max_len}"
        publishDir = [ path: "${params.outdir}/nanoq", mode: 'copy' ]
    }
    withName: EMU_ABUNDANCE {
        publishDir = [ path: { "${params.outdir}/emu/${task.tag}" }, mode: 'copy' ]
    }
}
